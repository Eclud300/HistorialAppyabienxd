<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HistorialApp.Views.Historial">
    <ContentPage.Content>
        <VerticalStackLayout Padding="20" Spacing="10">
            <Label Text="Historial" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" />

            <CollectionView ItemsSource="{Binding Historial}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="10" Margin="5" CornerRadius="10" BackgroundColor="#EEEEEE">
                            <Grid ColumnDefinitions="*,*,*">
                                <Label Text="{Binding Dia}" 
                                       FontSize="16" 
                                       FontAttributes="Bold" 
                                       Grid.Column="0" />
                                <Label Text="{Binding Porcentaje}" 
                                       FontSize="16" 
                                       TextColor="Green" 
                                       HorizontalTextAlignment="Center"
                                       Grid.Column="1" />
                                <Label Text="{Binding Tiempo}" 
                                       FontSize="16" 
                                       TextColor="Gray" 
                                       HorizontalTextAlignment="End"
                                       Grid.Column="2" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ContentPage.Content>
</ContentPage>